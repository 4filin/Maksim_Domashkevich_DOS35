{
  "packer": {
    "required_plugins": {
      "hyperv": {
        "version": ">= 1.1.3",
        "source": "github.com/hashicorp/hyperv"
      }
    }
  },
  "variables": {
    "iso_url": "C:/OLD_LAPTOP/BOOKS/DEVOPS/Linux/ubuntu-24.04.4-live-server-amd64.iso",
    "iso_checksum": "none",
    "ssh_username": "maksim",
    "ssh_private_key_file": "./packer_key"
  },
  "builders": [
    {
      "type": "hyperv-iso",
      "name": "vm1",
      "iso_url": "{{user `iso_url`}}",
      "iso_checksum": "{{user `iso_checksum`}}",
      "disk_size": 5120,
      "memory": 2048,
      "cpus": 2,
      "switch_name": "Default Switch",
      "http_directory": "./http/vm1",
      "generation": 2,
      "boot_wait": "5s",
      "boot_command": [
        "c<wait>",
        "set gfxpayload=keep<enter>",
        "linux /casper/vmlinuz autoinstall ds=nocloud-net;s=http://{{ .HTTPIP }}:{{ .HTTPPort }}/ ---<enter>",
        "initrd /casper/initrd<enter>",
        "boot<enter>"
      ],
      "ssh_username": "{{user `ssh_username`}}",
      "ssh_private_key_file": "{{user `ssh_private_key_file`}}",
      "ssh_timeout": "30m",
      "ssh_handshake_attempts": 100,
      "shutdown_command": "echo '{{user `ssh_username`}}' | sudo -S shutdown -P now",
      "output_directory": "output-vm1",
      "vm_name": "VM1-Ubuntu"
    },
    {
      "type": "hyperv-iso",
      "name": "vm2",
      "iso_url": "{{user `iso_url`}}",
      "iso_checksum": "{{user `iso_checksum`}}",
      "disk_size": 5120,
      "memory": 2048,
      "cpus": 2,
      "switch_name": "Default Switch",
      "http_directory": "./http/vm2",
      "generation": 2,
      "boot_wait": "5s",
      "boot_command": [
        "c<wait>",
        "set gfxpayload=keep<enter>",
        "linux /casper/vmlinuz autoinstall ds=nocloud-net;s=http://{{ .HTTPIP }}:{{ .HTTPPort }}/ ---<enter>",
        "initrd /casper/initrd<enter>",
        "boot<enter>"
      ],
      "ssh_username": "{{user `ssh_username`}}",
      "ssh_private_key_file": "{{user `ssh_private_key_file`}}",
      "ssh_timeout": "30m",
      "ssh_handshake_attempts": 100,
      "shutdown_command": "echo '{{user `ssh_username`}}' | sudo -S shutdown -P now",
      "output_directory": "output-vm2",
      "vm_name": "VM2-Ubuntu"
    }
  ],
  "provisioners": [
    {
      "only": ["hyperv-iso.vm2"],
      "type": "shell",
      "inline": [
        "sudo apt-get update",
        "sudo apt-get install -y iptables-persistent netfilter-persistent",
        "sudo iptables -A OUTPUT -p tcp --dport 22 -d 10.0.0.1 -j DROP",
        "sudo netfilter-persistent save",
        "echo 'VM2: SSH to host blocked'"
      ]
    }
  ]
}